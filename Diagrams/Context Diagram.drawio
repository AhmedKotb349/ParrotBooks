        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;%% Figure 1 - Level 0 Context Diagram\n%% Import into draw.io: Extras &gt; Edit Diagram &gt; paste this whole block\n%% (prefixed with ```mermaid ... ``` is NOT needed inside draw.io&#39;s Mermaid import,\n%% but IS needed if pasting into a markdown mermaid live editor)\n\nflowchart LR\n    classDef center fill:#AECBEB,stroke:#2F5C8A,stroke-width:2px,color:#000;\n    classDef ext fill:#EFE4C8,stroke:#7A6A3A,stroke-width:1.5px,color:#000;\n\n    SYS((Parrot Books&lt;br/&gt;Sales System)):::center\n\n    CUST[Customer]:::ext\n    PUB[Publisher]:::ext\n    WSD[\&quot;Warehouse and Shipping Dept.\&quot;]:::ext\n    CCD[\&quot;Credit Control Dept.\&quot;]:::ext\n    PBSTAFF[\&quot;Purchasing / Buying Staff\&quot;]:::ext\n    SA[System Administrator]:::ext\n    DCP[\&quot;Delivery / Carrier Partner\&quot;]:::ext\n    BANK[Bank]:::ext\n    MKT[Marketing Department]:::ext\n\n    CUST -- \&quot;Sales Order, Cheque Payment\&quot; --&gt; SYS\n    SYS -- \&quot;Order Acknowledgement, Invoice, Statement\&quot; --&gt; CUST\n\n    SYS -- \&quot;Purchase Requisition / Purchase Order\&quot; --&gt; PUB\n    PUB -- \&quot;Goods Received Note\&quot; --&gt; SYS\n\n    SYS -- \&quot;Picking Ticket, Sales Order Ack.\&quot; --&gt; WSD\n    WSD -- \&quot;Picking / Despatch Confirmation\&quot; --&gt; SYS\n\n    SYS -- \&quot;Order/Invoice Copy\&quot; --&gt; CCD\n    CCD -- \&quot;Payment Status\&quot; --&gt; SYS\n\n    SYS -- \&quot;Stock Shortfall Data\&quot; --&gt; PBSTAFF\n    PBSTAFF -- \&quot;Requisition Approval\&quot; --&gt; SYS\n\n    SYS -- \&quot;System Config and Audit Data\&quot; --&gt; SA\n    SA -- \&quot;Catalogue/User Maintenance\&quot; --&gt; SYS\n\n    SYS -- \&quot;Despatch Note / Delivery Details\&quot; --&gt; DCP\n    DCP -- \&quot;Delivery Confirmation\&quot; --&gt; SYS\n\n    SYS -- \&quot;Bank Deposit Slip\&quot; --&gt; BANK\n\n    SYS -- \&quot;Sales and Customer Reports\&quot; --&gt; MKT&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="LCUcaDfFGF5ZyscSzGjB-1">
