        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;%% Figure 3 - Use Case Diagram (staff actors on left, Customer on right)\n%% Import into draw.io: Extras &gt; Edit Diagram &gt; paste this whole block\n\nflowchart LR\n    classDef actor fill:#FFFFFF,stroke:#000000,stroke-width:1px,color:#000;\n    classDef usecase fill:#C7D6E8,stroke:#2F5C8A,stroke-width:1px,color:#000;\n    classDef abstractUC fill:#FFFFFF,stroke:#2F5C8A,stroke-width:1px,stroke-dasharray: 4 3,color:#000;\n\n    %% Actors\n    Customer[\&quot;Customer\&quot;]:::actor\n    WarehouseStaff[\&quot;Warehouse Staff\&quot;]:::actor\n    Administrator[\&quot;Administrator\&quot;]:::actor\n    ShippingStaff[\&quot;Shipping Staff\&quot;]:::actor\n    CreditControlClerk[\&quot;Credit Control Clerk\&quot;]:::actor\n    SalesStaff[\&quot;Sales Staff\&quot;]:::actor\n    Cashier[\&quot;Cashier\&quot;]:::actor\n\n    subgraph SYS[\&quot;Parrot Books Sales System\&quot;]\n        direction TB\n        UC1([\&quot;Generate Picking Ticket\&quot;]):::usecase\n        UC2([\&quot;Record Goods Received\&quot;]):::usecase\n        UC3([\&quot;Generate Sales and Aging Reports\&quot;]):::usecase\n        UC4([\&quot;Manage Book Catalogue\&quot;]):::usecase\n        UC5([\&quot;Manage User Accounts\&quot;]):::usecase\n        UC6([\&quot;Send Low-Stock Alert\&quot;]):::usecase\n        UC7([\&quot;Generate Despatch Note\&quot;]):::usecase\n        UC8([\&quot;Track Order Status\&quot;]):::usecase\n        UC9([\&quot;Generate Sales Invoice\&quot;]):::usecase\n        UC10([\&quot;Generate Customer Statement\&quot;]):::usecase\n        UC11([\&quot;Generate Sales Acknowledgement\&quot;]):::usecase\n        UC12([\&quot;Cancel Order\&quot;]):::usecase\n        UC13([\&quot;View Order History\&quot;]):::usecase\n        UC14([\&quot;Register Customer Account\&quot;]):::usecase\n        UC15([\&quot;Place Sales Order\&quot;]):::usecase\n        UC16([\&quot;Validate Sales Order\&quot;]):::usecase\n        UC17([\&quot;Record Customer Payment\&quot;]):::usecase\n        UC18([\&quot;Prepare Bank Deposit\&quot;]):::usecase\n        UC19([\&quot;Check Stock Availability\&quot;]):::usecase\n        UC20([\&quot;Raise Purchase Requisition\&quot;]):::usecase\n        UC21([\&quot;Authenticate User\&quot;]):::abstractUC\n    end\n\n    %% Warehouse Staff\n    WarehouseStaff --- UC1\n    WarehouseStaff --- UC2\n\n    %% Administrator\n    Administrator --- UC3\n    Administrator --- UC4\n    Administrator --- UC5\n    Administrator --- UC6\n\n    %% Shipping Staff\n    ShippingStaff --- UC7\n    ShippingStaff --- UC8\n\n    %% Credit Control Clerk\n    CreditControlClerk --- UC9\n    CreditControlClerk --- UC10\n\n    %% Sales Staff\n    SalesStaff --- UC11\n    SalesStaff --- UC12\n    SalesStaff --- UC13\n    SalesStaff --- UC15\n    SalesStaff --- UC17\n    SalesStaff --- UC18\n\n    %% Cashier\n    Cashier --- UC17\n    Cashier --- UC18\n\n    %% Customer (right side actor, connects to most use cases)\n    Customer --- UC8\n    Customer --- UC9\n    Customer --- UC10\n    Customer --- UC11\n    Customer --- UC12\n    Customer --- UC13\n    Customer --- UC14\n    Customer --- UC15\n    Customer --- UC17\n\n    %% Include / Extend relationships\n    UC15 -.-&gt;|\&quot;&amp;lt;&amp;lt;include&amp;gt;&amp;gt;\&quot;| UC16\n    UC16 -.-&gt;|\&quot;&amp;lt;&amp;lt;include&amp;gt;&amp;gt;\&quot;| UC21\n    UC16 -.-&gt;|\&quot;&amp;lt;&amp;lt;include&amp;gt;&amp;gt;\&quot;| UC19\n    UC14 -.-&gt;|\&quot;&amp;lt;&amp;lt;include&amp;gt;&amp;gt;\&quot;| UC21\n    UC17 -.-&gt;|\&quot;&amp;lt;&amp;lt;extend&amp;gt;&amp;gt;\&quot;| UC18\n    UC19 -.-&gt;|\&quot;&amp;lt;&amp;lt;extend&amp;gt;&amp;gt;\&quot;| UC20&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="iW4Z-JTantcsz0SEA4pS-181">
