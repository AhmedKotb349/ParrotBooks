<mxfile host="Electron">
  <diagram id="zP05cVDkN1g-WVs4LUTd" name="Page-1">
    <mxGraphModel dx="4580" dy="3310" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    %% ===== Domain Entities =====\n    class Book {\n        -String isbn\n        -String title\n        -Decimal listPrice\n        -int quantityOnHand\n        -String publisherId\n        +checkAvailability(qty int) bool\n        +reduceStock(qty int) void\n        +increaseStock(qty int) void\n    }\n    class Publisher {\n        -String publisherId\n        -String name\n        -String address\n    }\n    class Customer {\n        -String customerId\n        -String name\n        -String billingAddress\n        -String shippingAddress\n        -Decimal outstandingBalance\n    }\n    class SalesOrder {\n        -String orderNo\n        -String customerId\n        -Date orderDate\n        -OrderStatus status\n        -List~SalesOrderItem~ items\n        +validate() bool\n        +calculateTotal() Decimal\n        +changeStatus(s OrderStatus) void\n    }\n    class SalesOrderItem {\n        -String isbn\n        -int quantity\n        -Decimal priceEach\n        +extendedPrice() Decimal\n    }\n    class OrderStatus {\n        &lt;&lt;enumeration&gt;&gt;\n        RECEIVED\n        VALIDATED\n        REJECTED\n        AWAITING_STOCK\n        ACKNOWLEDGED\n        PICKING\n        DESPATCHED\n        INVOICED\n        PAID\n        CLOSED\n    }\n    class PurchaseRequisition {\n        -String requisitionNo\n        -String publisherId\n        -Date requisitionDate\n        -List~RequisitionItem~ items\n    }\n    class PurchaseOrder {\n        -String poNo\n        -String requisitionNo\n        -String publisherId\n        -Date orderDate\n    }\n    class GoodsReceivedNote {\n        -String grnNo\n        -String poNo\n        -Date dateReceived\n        -String carrier\n    }\n    class PickingTicket {\n        -String ticketNo\n        -String orderNo\n        -String status\n        +markPicked() void\n    }\n    class DespatchNote {\n        -String despatchNo\n        -String orderNo\n        -String carrier\n        -Date despatchDate\n    }\n    class Invoice {\n        -String invoiceNo\n        -String despatchNo\n        -Decimal totalAmount\n        -String status\n        +markPaid() void\n    }\n    class Payment {\n        &lt;&lt;Cheque Only&gt;&gt;\n        -String remittanceNo\n        -String customerId\n        -Decimal chequeAmount\n        -String chequeNumber\n        -Date dateReceived\n        +matchToInvoices(List~Invoice~) bool\n    }\n    class CustomerStatement {\n        -String statementNo\n        -String customerId\n        -Date statementDate\n        -Decimal balanceDue\n    }\n\n    Customer \&quot;1\&quot; --&gt; \&quot;*\&quot; SalesOrder : places\n    SalesOrder \&quot;1\&quot; *-- \&quot;*\&quot; SalesOrderItem : contains\n    SalesOrder --&gt; OrderStatus\n    Book \&quot;1\&quot; --&gt; \&quot;*\&quot; SalesOrderItem : referenced by\n    Publisher \&quot;1\&quot; --&gt; \&quot;*\&quot; Book : supplies\n    Publisher \&quot;1\&quot; --&gt; \&quot;*\&quot; PurchaseRequisition : receives\n    PurchaseRequisition \&quot;1\&quot; --&gt; \&quot;0..1\&quot; PurchaseOrder : becomes\n    PurchaseOrder \&quot;1\&quot; --&gt; \&quot;*\&quot; GoodsReceivedNote : fulfilled by\n    SalesOrder \&quot;1\&quot; --&gt; \&quot;0..1\&quot; PickingTicket : generates\n    PickingTicket \&quot;1\&quot; --&gt; \&quot;0..1\&quot; DespatchNote : generates\n    DespatchNote \&quot;1\&quot; --&gt; \&quot;1\&quot; Invoice : generates\n    Customer \&quot;1\&quot; --&gt; \&quot;*\&quot; Payment : pays by cheque\n    Payment \&quot;*\&quot; --&gt; \&quot;*\&quot; Invoice : settles\n    Customer \&quot;1\&quot; --&gt; \&quot;*\&quot; CustomerStatement : receives\n\n    %% ===== Singleton Pattern =====\n    class OrderManager {\n        &lt;&lt;Singleton&gt;&gt;\n        -static instance OrderManager\n        -persistence IOrderPersistence\n        -observers List~OrderObserver~\n        +getInstance()$ OrderManager\n        +createOrder(c Customer, items List) SalesOrder\n        +validateOrder(o SalesOrder) bool\n        +registerObserver(o OrderObserver) void\n        +notifyObservers(order SalesOrder) void\n    }\n    OrderManager ..&gt; SalesOrder : manages\n    OrderManager --&gt; \&quot;*\&quot; IOrderPersistence\n\n    %% ===== Observer Pattern =====\n    class OrderObserver {\n        &lt;&lt;Interface&gt;&gt;\n        +update(order SalesOrder) void\n    }\n    class LowStockNotifier {\n        &lt;&lt;Observer&gt;&gt;\n        +update(order SalesOrder) void\n    }\n    class OrderAuditLogger {\n        &lt;&lt;Observer&gt;&gt;\n        +update(order SalesOrder) void\n    }\n    class CustomerNotificationService {\n        &lt;&lt;Observer&gt;&gt;\n        +update(order SalesOrder) void\n    }\n    OrderObserver &lt;|.. LowStockNotifier\n    OrderObserver &lt;|.. OrderAuditLogger\n    OrderObserver &lt;|.. CustomerNotificationService\n    OrderManager --&gt; \&quot;*\&quot; OrderObserver : notifies\n\n    %% ===== Proxy Pattern =====\n    class IOrderPersistence {\n        &lt;&lt;Interface&gt;&gt;\n        +save(o SalesOrder) void\n        +findByOrderNo(no String) SalesOrder\n        +findAll() List~SalesOrder~\n    }\n    class OrderPersistenceService {\n        &lt;&lt;RealSubject&gt;&gt;\n        -database Map~String, SalesOrder~\n        +save(o SalesOrder) void\n        +findByOrderNo(no String) SalesOrder\n        +findAll() List~SalesOrder~\n    }\n    class OrderPersistenceProxy {\n        &lt;&lt;Proxy&gt;&gt;\n        -realService OrderPersistenceService\n        -cache Map~String, SalesOrder~\n        +save(o SalesOrder) void\n        +findByOrderNo(no String) SalesOrder\n        +findAll() List~SalesOrder~\n    }\n    IOrderPersistence &lt;|.. OrderPersistenceService\n    IOrderPersistence &lt;|.. OrderPersistenceProxy\n    OrderPersistenceProxy --&gt; OrderPersistenceService : delegates to\n\n    %% ===== Factory Pattern =====\n    class DocumentFactory {\n        &lt;&lt;Factory&gt;&gt;\n        +createAcknowledgement(o SalesOrder)$ Document\n        +createPickingTicket(o SalesOrder)$ Document\n        +createDespatchNote(o SalesOrder)$ Document\n        +createInvoice(o SalesOrder)$ Invoice\n        +createCustomerStatement(c Customer)$ CustomerStatement\n    }\n    class Document {\n        &lt;&lt;abstract&gt;&gt;\n        -String documentNo\n        -Date createdDate\n        +print() void\n        +export() String\n    }\n    DocumentFactory ..&gt; Document : creates\n    DocumentFactory ..&gt; Invoice : creates\n    DocumentFactory ..&gt; CustomerStatement : creates\n\n    %% ===== Strategy Pattern =====\n    class PaymentMatchingStrategy {\n        &lt;&lt;Interface&gt;&gt;\n        +match(payment Payment, invoices List~Invoice~) bool\n    }\n    class ExactAmountMatchStrategy {\n        &lt;&lt;Strategy&gt;&gt;\n        +match(payment Payment, invoices List~Invoice~) bool\n    }\n    class PartialAllocationMatchStrategy {\n        &lt;&lt;Strategy&gt;&gt;\n        +match(payment Payment, invoices List~Invoice~) bool\n    }\n    PaymentMatchingStrategy &lt;|.. ExactAmountMatchStrategy\n    PaymentMatchingStrategy &lt;|.. PartialAllocationMatchStrategy\n    Payment --&gt; PaymentMatchingStrategy : uses\n\n    %% ===== Builder Pattern =====\n    class SalesOrderBuilder {\n        &lt;&lt;Builder&gt;&gt;\n        -SalesOrder order\n        +forCustomer(c Customer) SalesOrderBuilder\n        +addItem(isbn String, qty int) SalesOrderBuilder\n        +build() SalesOrder\n    }\n    SalesOrderBuilder ..&gt; SalesOrder : builds\n\n    %% ===== Adapter Pattern =====\n    class INominalLedgerAdapter {\n        &lt;&lt;Interface&gt;&gt;\n        +postEntry(invoice Invoice) void\n        +postDeposit(payment Payment) void\n    }\n    class NominalLedgerAdapter {\n        &lt;&lt;Adapter&gt;&gt;\n        -LegacyLedgerSystem legacyLedger\n        +postEntry(invoice Invoice) void\n        +postDeposit(payment Payment) void\n    }\n    class LegacyLedgerSystem {\n        &lt;&lt;External System&gt;&gt;\n        +writeJournalLine(code String, amount Decimal) void\n    }\n    INominalLedgerAdapter &lt;|.. NominalLedgerAdapter\n    NominalLedgerAdapter --&gt; LegacyLedgerSystem : adapts\n    Invoice ..&gt; INominalLedgerAdapter : posted via\n    Payment ..&gt; INominalLedgerAdapter : posted via\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="245">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
